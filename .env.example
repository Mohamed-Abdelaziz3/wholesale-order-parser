# ---------------------------------------------------------------------------
# Extraction provider
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the model fallback chain (comma separated, first is tried first)
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash

# ---------------------------------------------------------------------------
# Authentication  (REQUIRED for any real deployment)
# ---------------------------------------------------------------------------
# Option A - one shared password, operators type their own name at sign-in:
APP_PASSWORD=change_me_before_deploying

# Option B - named accounts (takes precedence over APP_PASSWORD):
# APP_USERS=ahmed:S0meStrongPass,mona:An0therStrongPass

# Signs the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# If unset, a random one is generated per process and sessions drop on restart.
APP_SESSION_SECRET=

# Session lifetime in seconds (default 43200 = 12 hours)
# APP_SESSION_MAX_AGE=43200

# Set to true when serving over HTTPS so the session cookie is HTTPS-only.
SESSION_HTTPS_ONLY=false

# Extra browser origins allowed to make state-changing requests. The app's own
# origin is always allowed; add entries only if you serve it under more names.
# ALLOWED_ORIGINS=https://wop.example.com

# Only enable behind a proxy you control. When true, X-Forwarded-For is used as
# the login-throttle key; when false (default) the real socket address is used,
# so a spoofed header cannot buy extra password attempts.
TRUST_PROXY_HEADERS=false

# Proxy addresses uvicorn accepts forwarded headers from (loopback by default).
# FORWARDED_ALLOW_IPS=127.0.0.1

# /docs, /redoc and /openapi.json are unauthenticated by design in FastAPI and
# are therefore disabled unless you turn them on for local development.
EXPOSE_API_DOCS=false

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# Path to the SQLite database (defaults to ./orders.db next to the app package)
# ORDERS_DB_PATH=

# Seed catalog used on first run only, before any upload
# CATALOG_PATH=catalog.csv

# Inert. A truthy value is logged and ignored: autonomous auto-accept is not
# available in this build.
RR_K_AUTO_ACCEPT_ENABLED=false
