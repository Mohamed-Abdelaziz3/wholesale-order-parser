# This file is a field reference only. Do not copy it into a cloud-synchronised
# repository folder. For local development use C:\ProgramData\wop\wop.env or
# set WOP_ENV_FILE to an absolute, non-synchronised path. Railway uses service
# variables; do not upload an .env file.

# APP_ENV=development locally. Railway must set APP_ENV=production explicitly.
APP_ENV=development

# ---------------------------------------------------------------------------
# Extraction provider
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey. Set the real value only in
# the process environment / a machine-local env file / Railway service variable.
# GEMINI_API_KEY=

# Optional: override the model fallback chain (comma separated, first is tried first)
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash

# ---------------------------------------------------------------------------
# Authentication  (REQUIRED for any real deployment)
# ---------------------------------------------------------------------------
# Local development may use APP_PASSWORD, but pilot production requires named
# accounts only. Generate each password independently, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# APP_USERS=operator:paste-a-generated-password-here

# Signs the session cookie. Generate a distinct value per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SESSION_SECRET=

# Session lifetime in seconds (default 43200 = 12 hours)
# APP_SESSION_MAX_AGE=43200

# Production must set this to true; startup refuses false/missing in APP_ENV=production.
SESSION_HTTPS_ONLY=false

# Extra browser origins allowed to make state-changing requests. The app's own
# origin is always allowed; add entries only if you serve it under more names.
# ALLOWED_ORIGINS=https://wop.example.com

# Only enable behind a proxy you control. Uvicorn validates the proxy's TCP
# peer first, then provides the normalised client address to the application.
TRUST_PROXY_HEADERS=false

# Proxy addresses uvicorn accepts forwarded headers from (loopback by default).
# Railway pilot value is documented in docs/pilot/RAILWAY_SINGLE_MERCHANT_DEPLOYMENT.md.
# FORWARDED_ALLOW_IPS=127.0.0.1

# /docs, /redoc and /openapi.json are unauthenticated by design in FastAPI and
# are therefore disabled unless you turn them on for local development.
EXPOSE_API_DOCS=false

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# Path to the SQLite database. APP_ENV=production requires this path inside
# PERSISTENT_VOLUME_PATH and must never fall back to the container filesystem.
# ORDERS_DB_PATH=

# Railway pilot only: exact volume mount path, set explicitly to /app/data.
# PERSISTENT_VOLUME_PATH=/app/data
# CATALOG_BACKUP_DIR=/app/data/catalog-backups

# Seed catalog used on first run only, before any upload
# CATALOG_PATH=catalog.csv

# Inert. A truthy value is logged and ignored: autonomous auto-accept is not
# available in this build.
RR_K_AUTO_ACCEPT_ENABLED=false
